                    "leftValue": "={{ $json.state }}",
                    "rightValue": "VALIDATED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "131b12e7-0a2d-4867-beb6-9b956598247e"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "VALIDATED"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 4
                },
                "conditions": [
                  {
