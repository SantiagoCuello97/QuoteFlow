                    "id": "50489183-f14d-40c0-86f3-6752ed0ca2ed",
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "^(APPROVED|REJECTED)$",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ALREADY_DECIDED"
            }
          ]
        },
        "looseTypeValidation": "={{ false }}",
        "options": {
          "fallbackOutput": "extra"
        }
      },
